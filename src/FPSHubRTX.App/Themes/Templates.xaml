<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:FPSHubRTX.App.Controls"
                    xmlns:vm="clr-namespace:FPSHubRTX.ViewModels;assembly=FPSHubRTX.ViewModels">

    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:InverseBoolConverter x:Key="Not" />
    <c:HasValueToVisibilityConverter x:Key="HasValueToVis" />
    <c:HexToBrushConverter x:Key="HexToBrush" />
    <c:PathToImageConverter x:Key="PathToImage" DecodeWidth="360" />
    <c:StateToBrushConverter x:Key="StateToBrush" />
    <c:FractionToWidthConverter x:Key="FractionToWidth" />

    <!--
        Game card: cover, name, status, drive, last played, playtime, live FPS (only when measured),
        PLAY, favourite and a settings menu.
    -->
    <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
        <Border x:Name="Root" Width="204" Margin="0,0,16,16" CornerRadius="14" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="False" RenderTransformOrigin="0.5,0.5"
                ToolTip="{Binding StatusDetail}" ToolTipService.IsEnabled="{Binding HasProblem}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Play" Tag="&#xE768;" Command="{Binding PlayCommand}" />
                    <MenuItem Header="Game settings &amp; profile…" Tag="&#xE713;" Command="{Binding EditCommand}" />
                    <Separator />
                    <MenuItem Header="Open install folder" Tag="&#xE838;" Command="{Binding OpenFolderCommand}" />
                    <MenuItem Header="Open in launcher" Tag="&#xE8A7;" Command="{Binding OpenLauncherPageCommand}" />
                    <MenuItem Header="Verify files in launcher" Tag="&#xE73E;" Command="{Binding VerifyFilesCommand}" />
                    <Separator />
                    <MenuItem Header="Choose executable…" Tag="&#xE756;" Command="{Binding ChooseExecutableCommand}" />
                    <MenuItem Header="Change cover art…" Tag="&#xEB9F;" Command="{Binding ChangeCoverCommand}" />
                    <MenuItem Header="Locate moved installation…" Tag="&#xE721;" Command="{Binding LocateCommand}" />
                    <Separator />
                    <MenuItem Header="Remove from library (keeps the game)" Tag="&#xE74D;" Command="{Binding RemoveCommand}" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="272" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cover -->
                <Border CornerRadius="14,14,0,0" ClipToBounds="True">
                    <Grid>
                        <Border Background="{Binding PlaceholderColor, Converter={StaticResource HexToBrush}}" CornerRadius="14,14,0,0">
                            <Grid>
                                <Border Background="{DynamicResource AccentGradient}" Opacity="0.55" CornerRadius="14,14,0,0" />
                                <TextBlock Text="{Binding Initials}" FontSize="54" FontWeight="Bold" Foreground="White" Opacity="0.92"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" />
                            </Grid>
                        </Border>
                        <Image Source="{Binding CoverPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{StaticResource CoverFadeBrush}" />

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding LauncherName}" FontSize="10.5" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Command="{Binding FavoriteCommand}" ToolTip="Favourite" Foreground="White" FontSize="16">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE734;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="#FBBF24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,10">
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Background="#CC10B981" Margin="0,0,0,6"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,6,0" />
                                    <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding CurrentFpsText}" FontSize="10" FontWeight="Bold" Foreground="White" Margin="8,0,0,0"
                                               Visibility="{Binding HasCurrentFps, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Background="#CCF43F5E" Margin="0,0,0,6"
                                    Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       MaxHeight="42" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Details + actions -->
                <StackPanel Grid.Row="1" Margin="12,10,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <Run Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" />
                            <Run Text="{Binding Drive, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding PlaytimeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding StatusText}"
                                   Foreground="{Binding Status, Converter={StaticResource StateToBrush}}" TextWrapping="NoWrap" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="Last played:" />
                        <Run Text="{Binding LastPlayedText, Mode=OneWay}" />
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}" Padding="0,9" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{Binding PlayButtonText}" FontWeight="Bold" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE712;" ToolTip="More options"
                                c:MenuButton.OpenOnClick="True" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Game settings &amp; profile…" Tag="&#xE713;" Command="{Binding EditCommand}" />
                                    <MenuItem Header="Open install folder" Tag="&#xE838;" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="Open in launcher" Tag="&#xE8A7;" Command="{Binding OpenLauncherPageCommand}" />
                                    <MenuItem Header="Verify files in launcher" Tag="&#xE73E;" Command="{Binding VerifyFilesCommand}" />
                                    <Separator />
                                    <MenuItem Header="Choose executable…" Tag="&#xE756;" Command="{Binding ChooseExecutableCommand}" />
                                    <MenuItem Header="Change cover art…" Tag="&#xEB9F;" Command="{Binding ChangeCoverCommand}" />
                                    <MenuItem Header="Locate moved installation…" Tag="&#xE721;" Command="{Binding LocateCommand}" />
                                    <MenuItem Header="Show FPS monitor" Tag="&#xEC4A;" Command="{Binding MeasureFpsCommand}" />
                                    <Separator />
                                    <MenuItem Header="Remove from library (keeps the game)" Tag="&#xE74D;" Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Root" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#8B5CF6" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A label + value metric block used across pages -->
    <DataTemplate x:Key="MetricTileTemplate" DataType="{x:Type vm:MetricTile}">
        <Border Style="{StaticResource Card}" Margin="0,0,14,14" Width="236" ToolTip="{Binding Note}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Value}" Style="{StaticResource MetricValue}" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="5" Margin="0,10,0,0"
                             Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"
                           MaxHeight="46" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
