<UserControl x:Class="FPSHubRTX.App.Views.BenchmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FPSHubRTX.App.Controls"
             xmlns:vm="clr-namespace:FPSHubRTX.ViewModels;assembly=FPSHubRTX.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,6,28,28">
            <TextBlock Text="Benchmarks" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,18"
                       Text="Record measured frame times while you play a repeatable scene, then compare runs. FPS Hub warns you when two runs aren't directly comparable." />

            <!-- Recorder -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel IsEnabled="{Binding IsRecording, Converter={StaticResource Not}}">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="LABEL" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 'City market run'" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="SCENE / LOCATION" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Scene, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="RESOLUTION" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 2560x1440" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="GRAPHICS PRESET" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding GraphicsPreset, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. High, DLSS Quality" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="NOTES" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="260">
                        <TextBlock Text="{Binding RecordingElapsed}" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{DynamicResource Accent2Brush}" HorizontalAlignment="Center"
                                   Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,12" />
                        <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Padding="20,12" HorizontalContentAlignment="Center"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource Glyph}" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="Start benchmark" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Padding="20,12" HorizontalContentAlignment="Center"
                                Content="Stop &amp; save" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- History + details -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="8,4,4,8">
                            <Button DockPanel.Dock="Right" Content="Export all (CSV)" Command="{Binding ExportAllCommand}" Padding="10,5" />
                            <TextBlock Text="History" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" MaxHeight="520">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BenchmarkRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding Game, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Date, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Context}" Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AverageFps}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right">
                                                <Run Text="1%" /> <Run Text="{Binding OnePercentLow, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Visibility="{Binding Selected, Converter={StaticResource HasValueToVis}}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,6" />
                                <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,6" />
                                <Button Content="Save summary" Command="{Binding ExportReportCommand}" Margin="0,0,8,6" />
                                <Button Content="Copy summary" Command="{Binding CopyReportCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                                <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,6" />
                            </WrapPanel>
                            <c:LineChart Height="170" Values="{Binding SelectedFrameTimes}" Unit=" ms" Stroke="{DynamicResource Accent2Brush}"
                                         LabelBrush="{DynamicResource MutedBrush}" EmptyText="No frames in this run" />
                            <TextBox Text="{Binding SelectedReport, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Compare two runs" Style="{StaticResource H3}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding CompareA}" />
                                <TextBlock Grid.Column="1" Text="vs" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding History}" SelectedItem="{Binding CompareB}" />
                            </Grid>
                            <TextBox Text="{Binding ComparisonText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
