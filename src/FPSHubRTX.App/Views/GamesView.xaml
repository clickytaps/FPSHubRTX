<UserControl x:Class="FPSHubRTX.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,6,12,0">
        <!-- Header + filters -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddGameCommand}" Margin="0,0,8,0" ToolTip="Add any game by choosing its .exe">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Add game" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                            <TextBlock Text="Rescan" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="My Games" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                        <Run Text="Showing" /> <Run Text="{Binding ShownCount, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="games · right-click a card for more options" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,16,0,0">
                <Grid Width="260" Margin="0,0,10,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="32,7,10,7" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Margin="11,0,0,0" HorizontalAlignment="Left"
                               Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                    <TextBlock Text="Launcher" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding LauncherOptions}" SelectedItem="{Binding LauncherFilter}" MinWidth="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                    <TextBlock Text="Drive" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding DriveOptions}" SelectedItem="{Binding DriveFilter}" MinWidth="90" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                    <TextBlock Text="Collection" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding CollectionOptions}" SelectedItem="{Binding CollectionFilter}" MinWidth="130" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding NewCollectionCommand}" ToolTip="New collection" Margin="4,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteCollectionCommand}" ToolTip="Delete selected collection (games are kept)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                    <TextBlock Text="Sort" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption}" MinWidth="150" />
                </StackPanel>
                <CheckBox Content="Favourites" IsChecked="{Binding FavoritesOnly}" Margin="4,0,14,8" VerticalAlignment="Center" />
                <CheckBox Content="Show missing" IsChecked="{Binding ShowMissing}" Margin="0,0,0,8" VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty states -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="520" Margin="0,10,16,0"
                    Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Your library is empty" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14"
                               Text="Press Scan to search Steam, Epic Games, the Xbox app, GOG, Ubisoft Connect, the EA app, Battle.net, Riot, Minecraft, Roblox and any folders you choose. Nothing is launched or modified during a scan." />
                    <Button Content="Scan games now" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="520" Margin="0,10,16,0"
                    Visibility="{Binding NothingMatches, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="No games match these filters" Style="{StaticResource H3}" />
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
