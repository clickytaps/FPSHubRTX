<Window x:Class="FPSHubRTX.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Hub RTX" Width="640" Height="360" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True" Background="#0A0A10">
    <Grid>
        <Image Source="/Assets/splash.png" Stretch="UniformToFill" />
        <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,22">
            <TextBlock x:Name="Status" Text="Starting…" Foreground="#A6A6BC" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <ProgressBar IsIndeterminate="True" Height="3" Foreground="#22D3EE" Background="#1F1F2E" BorderThickness="0">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Border x:Name="Glow" Width="120" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="Move" X="-120" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="X" From="-120" To="560" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </StackPanel>
    </Grid>
</Window>
