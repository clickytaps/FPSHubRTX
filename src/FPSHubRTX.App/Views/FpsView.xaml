<UserControl x:Class="FPSHubRTX.App.Views.FpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FPSHubRTX.App.Controls">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}" />
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,6,28,28">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding RunningGames}" SelectedItem="{Binding Selected}" MinWidth="200" Margin="0,0,8,0" ToolTip="Running game to measure" />
                    <Button Command="{Binding StartCaptureCommand}" Content="Start measuring" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Command="{Binding StopCaptureCommand}" Content="Stop" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FPS Monitor" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding MetricSource}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- State banner -->
            <Border Margin="0,18,0,0" CornerRadius="12" Padding="16,12" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMeasuring}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Background" Value="#1AF43F5E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}">
                        <Run Text="{Binding StateTitle, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding GameName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding StateDetail, Converter={StaticResource HasValueToVis}}" />
                </StackPanel>
            </Border>

            <!-- Big numbers -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CURRENT FPS" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding CurrentFps}" FontSize="72" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                   Foreground="{DynamicResource AccentGradient}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Frame time" /> <Run Text="{Binding FrameTime, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="Session" /> <Run Text="{Binding SessionDuration, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <UniformGrid Columns="4" Rows="2">
                        <StackPanel Margin="0,0,0,14"><TextBlock Text="AVERAGE" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding AverageFps}" Style="{StaticResource StatValue}" /></StackPanel>
                        <StackPanel><TextBlock Text="1% LOW" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding OnePercentLow}" Style="{StaticResource StatValue}" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel><TextBlock Text="0.1% LOW" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PointOnePercentLow}" Style="{StaticResource StatValue}" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel><TextBlock Text="FRAMES" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding FrameCount}" Style="{StaticResource StatValue}" /></StackPanel>
                        <StackPanel><TextBlock Text="MINIMUM" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding MinFps}" Style="{StaticResource StatValue}" /></StackPanel>
                        <StackPanel><TextBlock Text="MAXIMUM" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding MaxFps}" Style="{StaticResource StatValue}" /></StackPanel>
                        <StackPanel><TextBlock Text="AVG FRAME TIME" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding AverageFrameTime}" Style="{StaticResource StatValue}" /></StackPanel>
                        <StackPanel><TextBlock Text="99TH PCT FRAME TIME" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding P99FrameTime}" Style="{StaticResource StatValue}" /></StackPanel>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- Graphs -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}">
                            <Run Text="Stutter frames (&gt;2× median):" /> <Run Text="{Binding StutterCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Frame-time history" Style="{StaticResource H3}" />
                    </DockPanel>
                    <c:LineChart Height="190" Margin="0,10,0,0" Values="{Binding FrameTimeSeries}" Unit=" ms" Stroke="{DynamicResource Accent2Brush}"
                                 LabelBrush="{DynamicResource MutedBrush}" EmptyText="No measured frames yet" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                        <Run Text="Stability:" /> <Run Text="{Binding Stability, Mode=OneWay}" />  <Run Text="  ·  Presentation:" /> <Run Text="{Binding PresentInfo, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="FPS per second" Style="{StaticResource H3}" />
                    <c:LineChart Height="150" Margin="0,10,0,0" Values="{Binding FpsSeries}" Stroke="{DynamicResource AccentBrush}"
                                 Fill="{DynamicResource AccentSoftBrush}" LabelBrush="{DynamicResource MutedBrush}" EmptyText="No measured frames yet" />
                </StackPanel>
            </Border>

            <!-- Troubleshooting (shown when unavailable) -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Measurement access" Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding PermissionStatus}" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <WrapPanel>
                        <Button Content="Allow FPS measuring without admin (one-time)" Command="{Binding FixPermissionsCommand}" Margin="0,0,8,8" />
                        <Button Content="Capture with admin rights" Command="{Binding StartElevatedCaptureCommand}" Margin="0,0,8,8" />
                        <Button Content="FPS settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <TextBlock Text="Troubleshooting" Style="{StaticResource H3}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding TroubleshootingTips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"
                               Text="Values come from PresentMon's frame-presentation events (no code is injected into games). When a game can't be measured, FPS Hub shows 'unavailable' instead of estimating." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
