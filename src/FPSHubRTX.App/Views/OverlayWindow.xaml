<Window x:Class="FPSHubRTX.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FPSHubRTX.App.Controls"
        xmlns:vm="clr-namespace:FPSHubRTX.ViewModels;assembly=FPSHubRTX.ViewModels"
        Title="FPS Hub RTX overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" FontFamily="{StaticResource DisplayFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="OverlayPanel" CornerRadius="10" Padding="12,8" BorderThickness="1" BorderBrush="Transparent" MinWidth="120">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayLine}">
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label, StringFormat={}{0}:}" Opacity="0.75" Margin="0,0,10,0" FontWeight="SemiBold"
                                       Foreground="{Binding DataContext.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexToBrush}}" />
                            <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" FontWeight="Bold" HorizontalAlignment="Right"
                                       Foreground="{Binding DataContext.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexToBrush}}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                <Setter TargetName="Value" Property="Foreground"
                                        Value="{Binding DataContext.AccentColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexToBrush}}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Grid.IsSharedSizeScope="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <c:LineChart Height="46" Width="190" Margin="0,6,0,0" Values="{Binding Graph}" ShowAxisLabels="False" StrokeThickness="1.2"
                         Stroke="{Binding AccentColor, Converter={StaticResource HexToBrush}}" EmptyText=""
                         Visibility="{Binding ShowGraph, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.8" Margin="0,4,0,0" MaxWidth="240" TextWrapping="Wrap"
                       Foreground="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
