<UserControl x:Class="FPSHubRTX.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FPSHubRTX.ViewModels;assembly=FPSHubRTX.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,6,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ============ Scan progress & results ============ -->
            <StackPanel>
                <TextBlock Text="Scan Games" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,18"
                           Text="FPS Hub reads launcher manifests, Windows install records and the folders you choose. It never scans whole drives, never launches anything and never changes game files." />

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Animated radar while scanning -->
                            <Grid Width="84" Height="84" Margin="0,0,20,0">
                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="2" />
                                <Ellipse Margin="16" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                                <Ellipse Margin="32" Fill="{DynamicResource AccentGradient}" />
                                <Grid Width="84" Height="84" RenderTransformOrigin="0.5,0.5" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                    <Grid.RenderTransform>
                                        <RotateTransform />
                                    </Grid.RenderTransform>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="Spin">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="Spin" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Path Data="M42,42 L42,0 A42,42 0 0 1 78,21 Z" Fill="{DynamicResource Accent2Brush}" Opacity="0.35" />
                                </Grid>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H2}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} games found">
                                            <Binding Path="GamesFound" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding CurrentSource}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CurrentLocation}" Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}" Padding="26,14"
                                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="White" Margin="0,0,10,0" />
                                        <TextBlock Text="SCAN GAMES" FontWeight="Bold" FontSize="15" Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Content="Cancel scan" Padding="22,12"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,22,0,0" Height="8" />

                        <!-- Per-source status -->
                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScanSourceRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Kind, Converter={StaticResource StateToBrush}}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Kind, Converter={StaticResource StateToBrush}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Completion summary -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" BorderBrush="{DynamicResource SuccessBrush}"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="View library" Command="{Binding ViewLibraryCommand}" Style="{StaticResource PrimaryButton}" />
                            <StackPanel>
                                <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SummaryDetails}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Scope controls ============ -->
            <StackPanel Grid.Column="2" IsEnabled="{Binding IsIdle}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sources to scan" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Launchers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LauncherToggle}">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Scan scope" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <CheckBox Content="Check X:\Games and X:\XboxGames on each drive" IsChecked="{Binding ScanCommonFolders}" />
                        <CheckBox Content="Include external / removable drives" IsChecked="{Binding IncludeRemovableDrives}" />
                        <CheckBox Content="Mark games that disappeared as missing" IsChecked="{Binding MarkMissingGames}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Add folder" Command="{Binding AddFolderCommand}" Padding="10,5" />
                            <TextBlock Text="Your game folders" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="Add folders on any SSD, HDD or external drive that contain games (one game per subfolder) or a single game's folder." />
                        <ItemsControl ItemsSource="{Binding CustomFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="4" />
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Exclude folder" Command="{Binding AddExcludedCommand}" Padding="10,5" />
                            <TextBlock Text="Excluded folders" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ExcludedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveExcludedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="4" />
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
