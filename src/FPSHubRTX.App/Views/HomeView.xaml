<UserControl x:Class="FPSHubRTX.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,6,28,28">

            <!-- Hero with the main SCAN GAMES button -->
            <Border CornerRadius="18" Padding="30,26" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#338B5CF6" />
                        <GradientStop Offset="0.6" Color="#143B82F6" />
                        <GradientStop Offset="1" Color="#2622D3EE" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="YOUR GAMING HUB" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent2Brush}" />
                        <TextBlock Text="Find every game. Launch it. See real FPS." Style="{StaticResource H1}" Margin="0,6,0,8" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="13.5">
                            <Run Text="{Binding GameCount, Mode=OneWay}" /><Run Text=" games in your library from " /><Run Text="{Binding LauncherCount, Mode=OneWay}" /><Run Text=" sources  ·  " /><Run Text="{Binding LastScanText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Padding="34,18"
                            VerticalAlignment="Center" ToolTip="Search Steam, Epic, Xbox, GOG, Ubisoft, EA, Battle.net, Riot, Minecraft, Roblox and your chosen folders">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White" Margin="0,0,14,0" />
                            <TextBlock Text="SCAN GAMES" FontSize="21" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource DisplayFont}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Stat tiles (all from collected data) -->
            <WrapPanel Margin="0,20,0,0">
                <Border Style="{StaticResource Card}" Width="232" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="GAMES DISCOVERED" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding GameCount}" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding InstalledCount, Mode=OneWay}" /><Run Text=" installed" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="RUNNING NOW" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding RunningCount}" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                        <TextBlock Text="Detected from running processes" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="AVERAGE MEASURED FPS" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding AverageFpsText}" Style="{StaticResource MetricValue}" Margin="0,6,0,2" Foreground="{DynamicResource Accent2Brush}" />
                        <TextBlock Text="{Binding AverageFpsCaption}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="PLAYED TODAY" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding TodayPlaytime}" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                        <Button Content="View statistics" Command="{Binding OpenStatsCommand}" Style="{StaticResource GhostButton}" Padding="10,5" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="232" Margin="0,0,14,14" BorderBrush="{DynamicResource Accent2Brush}"
                        Visibility="{Binding HasLiveFps, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="LIVE FPS" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent2Brush}" />
                        <TextBlock Text="{Binding LiveFpsText}" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                        <TextBlock Text="{Binding LiveFpsGame}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        <Button Content="Open FPS monitor" Command="{Binding OpenFpsCommand}" Style="{StaticResource GhostButton}" Padding="10,5" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Running games -->
            <StackPanel Visibility="{Binding RunningGames.Count, Converter={StaticResource HasValueToVis}}" Margin="0,10,0,0">
                <TextBlock Text="Running now" Style="{StaticResource H2}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding RunningGames}" ItemTemplate="{StaticResource GameCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Recently played -->
            <DockPanel Margin="0,14,0,14">
                <Button DockPanel.Dock="Right" Content="Open library" Command="{Binding OpenLibraryCommand}" Style="{StaticResource GhostButton}" Padding="12,6" />
                <TextBlock Text="Recently played" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding RecentGames}" ItemTemplate="{StaticResource GameCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Visibility="{Binding RecentGames.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="Nothing played yet" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Games you launch from FPS Hub (or that FPS Hub sees running) appear here with their playtime and measured FPS." />
                    <Button Content="Scan for games" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Visibility="{Binding NoGames, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
