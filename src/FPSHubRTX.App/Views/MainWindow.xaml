<Window x:Class="FPSHubRTX.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FPSHubRTX.ViewModels;assembly=FPSHubRTX.ViewModels"
        xmlns:views="clr-namespace:FPSHubRTX.App.Views"
        x:Name="Shell"
        Title="FPS Hub RTX" Width="1360" Height="860" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/FPSHubRTX.ico"
        Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><views:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FpsViewModel}"><views:FpsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><views:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarksViewModel}"><views:BenchmarksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}"><views:SessionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,14,12,22">
                        <Image Source="/Assets/logo-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" x:Name="BrandText">
                            <TextBlock Text="FPS HUB RTX" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource AccentGradient}" />
                            <TextBlock Text="Clickys Gaming Optimizer" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom: live status + overlay toggle -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
                        <Border Style="{StaticResource Card}" Padding="12" x:Name="StatusCard">
                            <StackPanel>
                                <TextBlock Text="NOW" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding RunningSummary}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12.5" />
                                <Button Command="{Binding ToggleOverlayCommand}" HorizontalContentAlignment="Center" Padding="8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Show overlay" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                                                            <Setter Property="Text" Value="Hide overlay" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" FontSize="11" Margin="6,10,0,0" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavItem}">
                                    <Button Style="{StaticResource NavButton}" ToolTip="{Binding Title}"
                                            Command="{Binding DataContext.NavigateCommand, ElementName=Shell}" CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" Width="22" />
                                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsNarrow, ElementName=Shell, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= Main area ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar (draggable via WindowChrome) -->
                <Grid>
                    <TextBlock Text="{Binding CurrentPageKey}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximise"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>

                <!-- Message banner -->
                <Border Grid.Row="1" Margin="28,0,28,10" CornerRadius="10" Padding="14,10"
                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                                    <Setter Property="Background" Value="#33F43F5E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissBannerCommand}"
                                ToolTip="Dismiss" Padding="6" />
                        <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
