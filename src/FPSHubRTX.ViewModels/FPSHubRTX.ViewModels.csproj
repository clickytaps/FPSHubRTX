    so this project builds (and is unit-testable) on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FPSHubRTX.ViewModels</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FPSHubRTX.Core\FPSHubRTX.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FPSHubRTX.Core.Tests" />
  </ItemGroup>
</Project>
